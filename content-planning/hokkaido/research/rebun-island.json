  "objectiveConditions": [
    {
      "id": "R1",
      "statement": "禮文島一年到頭都有風，全年平均風速 3.5 m/s、5 月最大；桃岩一帶標高不高也常有強風濃霧，夏天也要帶防風外套。",
      "sources": [
        "F36",
        "F489",
        "F444"
      ],
      "checkedAt": "2026-10-18"
    },
    {
      "id": "R2",
      "statement": "禮文島常起霧，6、7 月日照時數全年偏少，天氣像山上一樣多變，雨具和長袖要帶。",
      "sources": [
        "F442",
        "F490",
        "F444"
      ],
      "checkedAt": "2026-10-18"
    },
    {
      "id": "R3",
      "statement": "路線巴士班次少，冬季平日往須古頓一天只有 4～5 班，步道起訖點要先對好末班車。",
      "sources": [
        "F60",
        "F61",
        "F62",
        "F120",
        "F216"
      ],
      "checkedAt": "2026-10-18"
    },
    {
      "id": "R4",
      "statement": "餐廳和商店幾乎都集中在香深港周邊，往北部或步道前先在香深買好吃的喝的。",
      "sources": [
        "F419",
        "F458",
        "F469"
      ],
      "checkedAt": "2026-10-18"
    },
    {
      "id": "R5",
      "statement": "島上沒有棕熊和蛇，健行不用擔心熊。",
      "sources": [
        "F404"
      ],
      "checkedAt": "2026-10-18"
    },
    {
      "id": "R6",
      "statement": "8 小時步道大半段收不到手機訊號，中段沒有聚落，不要一個人走。",
      "sources": [
        "F38",
        "F469"
      ],
      "checkedAt": "2026-10-18"
    },
    {
      "id": "R7",
      "statement": "很多店和巴士只收現金，日圓現金要帶夠。",
      "sources": [
        "F51",
        "F58",
        "F64",
        "F302",
        "F449",
        "F450"
      ],
      "checkedAt": "2026-10-18"
    },
    {
      "id": "R8",
      "statement": "下雨後步道會泥濘，禮文瀑布步道溪水暴漲時會封路，雨天改走鋪裝路段。",
      "sources": [
        "F87",
        "F463"
      ],
      "checkedAt": "2026-10-18"
    },
    {
      "id": "R9",
      "statement": "島上租車只有 6 台、計程車 2 家，旺季想租車要提早聯絡。",
      "sources": [
        "F414",
        "F415"
      ],
      "checkedAt": "2026-10-18"
    }
