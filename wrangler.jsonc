{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "japan-travel",
  "main": "workers/site/src/index.ts",
  "compatibility_date": "2026-08-25",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": true,
  // 正式網域（Custom Domain）：Cloudflare 會自動建立 DNS 紀錄與 HTTPS 憑證。
  "routes": [{"pattern": "offpathnotes.com", "custom_domain": true}],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  // 聯絡表單寄信用。allowed_sender_addresses 必須是 Cloudflare Email Service 已驗證的寄件地址；
  // 第一次部署前要在 Cloudflare Email Service 驗證這個地址，或暫時整段移除並停用聯絡表單。
  "send_email": [
    {
      "name": "CONTACT_EMAIL",
      "allowed_sender_addresses": ["contact@offpathnotes.com"]
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "head_sampling_rate": 0.1
    }
  }
}
