---
import ClusterHubList from './ClusterHubList.astro'
import type {SiteCategory} from '../data/categories'
import type {HubPageData} from '../data/hubs'
import {getHubPath} from '../data/hubs'
import BaseLayout from '../layouts/BaseLayout.astro'
import type {ClusterNode} from '../lib/clusters'
import {createCollectionStructuredData, type CollectionListItem} from '../lib/structuredData'

interface Props {
  category: SiteCategory
  hub: HubPageData
  childClusters?: ClusterNode[]
}

const {category, hub, childClusters = []} = Astro.props
const publishedArticles = hub.articles.filter((article) => article.published)
const childArticleCount = childClusters.reduce((total, child) => total + child.articleCount, 0)
const introductionParagraphs = hub.description
  .split(/\n{2,}/)
  .map((paragraph) => paragraph.trim())
  .filter(Boolean)
const parentPath = hub.parentHub
  ? `/${hub.categorySlug}/${hub.parentHub.slug}/`
  : null
const siteUrl = new URL('/', Astro.site ?? Astro.url).href
const canonicalUrl = new URL(getHubPath(hub), siteUrl).href
const childLinks: CollectionListItem[] = childClusters.length > 0
  ? childClusters.map((child) => ({name: child.title, url: new URL(child.path, siteUrl).href}))
  : (hub.childHubs ?? []).map((child) => ({name: child.title, url: new URL(child.path, siteUrl).href}))
const structuredData = createCollectionStructuredData({
  breadcrumbs: [
    {name: '首頁', url: siteUrl},
    {name: category.title, url: new URL(`/${category.slug}/`, siteUrl).href},
    ...(hub.parentHub && parentPath
      ? [{name: hub.parentHub.title, url: new URL(parentPath, siteUrl).href}]
      : []),
    {name: hub.title, url: canonicalUrl},
  ],
  canonicalUrl,
  description: hub.seoDescription,
  items: [
    ...childLinks,
    ...publishedArticles.map((article) => ({
      name: article.title,
      url: new URL(article.path ?? `${getHubPath(hub)}${article.slug}/`, siteUrl).href,
    })),
  ],
  name: hub.title,
  siteUrl,
})
---

<BaseLayout
  title={hub.seoTitle}
  description={hub.seoDescription}
  noindex={hub.noindex}
  structuredData={structuredData}
>
  <div class="shell breadcrumbs" aria-label="麵包屑導覽">
    <a href="/">首頁</a><span aria-hidden="true">/</span>
    <a href={`/${category.slug}/`}>{category.title}</a><span aria-hidden="true">/</span>
    {hub.parentHub && parentPath && <>
      <a href={parentPath}>{hub.parentHub.title}</a><span aria-hidden="true">/</span>
    </>}
    <span>{hub.title}</span>
  </div>

  <header class="topic-hero">
    <div class="shell topic-hero-grid">
      <div>
        <p class="eyebrow">{hub.eyebrow}</p>
        <h1>{hub.title}</h1>
        {introductionParagraphs.map((paragraph) => (
          <p class="topic-intro">{paragraph}</p>
        ))}
      </div>
      {hub.publicationPreview ? (
        <aside class="prototype-alert" aria-label="發布前預覽說明">
          <strong>發布前預覽</strong>
          <p>此頁只在本機產生，仍禁止搜尋引擎索引，也尚未部署到測試站。</p>
        </aside>
      ) : null}
    </div>
  </header>

  <section class="section topic-content">
    <div class="shell topic-layout">
      <div>
        <p class="eyebrow">閱讀範圍</p>
        <h2>{hub.title}的閱讀重點</h2>
        <ol class="topic-checklist">
          {hub.checklist.map((item) => <li>{item}</li>)}
        </ol>
      </div>
      <div>
        {childClusters.length > 0 ? (
          <div class="hub-children">
            <div class="section-heading compact-heading">
              <div>
                <p class="eyebrow">延伸主題</p>
                <h2>{hub.title}的子主題</h2>
              </div>
              <p>{childClusters.length} 個子主題、{childArticleCount} 篇文章，每個子主題都有自己的主題頁與文章。</p>
            </div>
            <ClusterHubList nodes={childClusters} headingTag="h3" />
          </div>
        ) : hub.childHubs && hub.childHubs.length > 0 && (
          <div class="hub-children">
            <div class="section-heading compact-heading">
              <div>
                <p class="eyebrow">延伸主題</p>
                <h2>{hub.title}的子主題</h2>
              </div>
            </div>
            <div class="article-list">
              {hub.childHubs.map((child, index) => (
                <a class="article-row" href={child.path}>
                  <span>{String(index + 1).padStart(2, '0')}</span>
                  <div>
                    <h3>{child.title}</h3>
                    <p>{child.description}</p>
                  </div>
                  <b aria-hidden="true">→</b>
                </a>
              ))}
            </div>
          </div>
        )}
        <div class="section-heading compact-heading">
          <div>
            <p class="eyebrow">主題文章</p>
            <h2>{childClusters.length > 0 ? `${hub.title}的跨子主題文章` : `${hub.title}相關文章`}</h2>
          </div>
          {publishedArticles.length > 0 && <p>{publishedArticles.length} 篇文章</p>}
        </div>
        <div class="article-list">
          {publishedArticles.map((article, index) => (
            <a class="article-row" href={article.path ?? `${getHubPath(hub)}${article.slug}/`}>
              <span>{String(index + 1).padStart(2, '0')}</span>
              <div>
                <h3>{article.title}</h3>
                <p>{article.excerpt}</p>
                {article.readTime && <small>{article.readTime}</small>}
              </div>
              <b aria-hidden="true">→</b>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
