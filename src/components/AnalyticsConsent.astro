---
import {GOOGLE_ANALYTICS_MEASUREMENT_ID} from '../config/google'
---

<section
  class="analytics-consent"
  data-analytics-consent
  role="region"
  aria-labelledby="analytics-consent-title"
  aria-describedby="analytics-consent-description"
  hidden
>
  <div>
    <p class="analytics-consent-title" id="analytics-consent-title">分析資料設定</p>
    <p id="analytics-consent-description">
      本站使用 Google Analytics 了解哪些內容被閱讀，不收集姓名、電子郵件等個人資料，也不用於廣告。不想被記錄可以按「關閉分析」，之後也能在頁尾重新設定。
    </p>
    <a href="/privacy/">查看隱私權政策</a>
  </div>
  <div class="analytics-consent-actions">
    <button type="button" data-analytics-decline>關閉分析</button>
    <button type="button" class="analytics-consent-accept" data-analytics-accept>知道了</button>
  </div>
</section>

<script is:inline define:vars={{measurementId: GOOGLE_ANALYTICS_MEASUREMENT_ID}}>
  (() => {
    // 預設開啟、可以退出（Darren 2026-10-21 決定）：沒選過或選「知道了」都載入 GA，選「關閉分析」才不載入。
    const preferenceKey = 'japan-travel-analytics-consent-v1'
    const banner = document.querySelector('[data-analytics-consent]')
    const acceptButton = document.querySelector('[data-analytics-accept]')
    const declineButton = document.querySelector('[data-analytics-decline]')
    const preferenceButtons = document.querySelectorAll('[data-open-analytics-consent]')
    let analyticsLoaded = false

    const readPreference = () => {
      try {
        return window.localStorage.getItem(preferenceKey)
      } catch {
        return null
      }
    }

    const savePreference = (value) => {
      try {
        window.localStorage.setItem(preferenceKey, value)
      } catch {
        // 瀏覽器阻擋本機儲存時，選擇只套用於目前頁面。
      }
    }

    const setBannerVisibility = (visible, {focus = false} = {}) => {
      if (!(banner instanceof HTMLElement)) return
      banner.hidden = !visible
      if (visible && acceptButton instanceof HTMLElement) {
        // 已經關閉分析的人，從頁尾打開時按鈕改成重新開啟
        acceptButton.textContent = readPreference() === 'denied' ? '重新開啟分析' : '知道了'
        if (focus) acceptButton.focus()
      }
    }

    const loadAnalytics = () => {
      if (analyticsLoaded) return
      analyticsLoaded = true

      window.dataLayer = window.dataLayer || []
      window.gtag = function () {
        window.dataLayer.push(arguments)
      }

      window.gtag('consent', 'default', {
        analytics_storage: 'granted',
        ad_storage: 'denied',
        ad_user_data: 'denied',
        ad_personalization: 'denied',
      })
      window.gtag('js', new Date())
      window.gtag('config', measurementId, {
        allow_google_signals: false,
        allow_ad_personalization_signals: false,
      })

      const googleTag = document.createElement('script')
      googleTag.async = true
      googleTag.src = `https://www.googletagmanager.com/gtag/js?id=${encodeURIComponent(measurementId)}`
      document.head.append(googleTag)
    }

    const preference = readPreference()
    if (preference !== 'denied') {
      loadAnalytics()
    }
    if (preference === null) {
      setBannerVisibility(true)
    }

    acceptButton?.addEventListener('click', () => {
      savePreference('granted')
      setBannerVisibility(false)
      loadAnalytics()
    })

    declineButton?.addEventListener('click', () => {
      const shouldReload = analyticsLoaded
      savePreference('denied')
      setBannerVisibility(false)

      if (shouldReload) {
        window.location.reload()
      }
    })

    preferenceButtons.forEach((button) => {
      button.addEventListener('click', () => setBannerVisibility(true, {focus: true}))
    })
  })()
</script>
