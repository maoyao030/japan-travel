---
import BaseLayout from '../layouts/BaseLayout.astro'
import {SITE_NAME} from '../config/site'
import {getHubPath, getPublishedCategories, PLACES_CATEGORY_SLUG, type HubPageData} from '../data/hubs'
import {getPublishedContentRoutes} from '../lib/contentRoutes'
import {IMAGE_SIZES, getResponsiveImage} from '../lib/images'
import {createWebSiteStructuredData} from '../lib/structuredData'

/**
 * 首頁（2026-10-21 Darren 選定「車站站牌」風格）。
 * 固定文字只寫網站一直不變的事；地點、地區與文章全部從已發布內容自動列出，
 * 新地區上線時不用回來改這頁。
 */
const {aspectDirectories, indexableHubs, landingArticles, monthPages, publishableHubs, routableArticles} =
  await getPublishedContentRoutes()
const homeCategories = getPublishedCategories(publishableHubs)

const indexableArticles = routableArticles.filter((route) => !route.article.noindex)
const countArticles = (hub: HubPageData) =>
  indexableArticles.filter((route) => route.hub.id === hub.id).length

const stories = [
  ...landingArticles.map(({article, hub}) => ({article, hub, path: getHubPath(hub)})),
  ...routableArticles.map(({article, hub, path}) => ({article, hub, path})),
]
  .filter(({article}) => article.cover && !article.noindex)
  .sort(
    (left, right) =>
      Date.parse(right.article.publishedAt) - Date.parse(left.article.publishedAt),
  )
const latestStories = stories.slice(0, 6)

// 地點站牌：地點依所屬地區分組，其他分類各自一組。只列已有文章的主題中心；
// 站牌下方的綠條列出已上線的鄰近地點。
const stopsOf = (hubs: HubPageData[]) =>
  hubs
    .filter((hub) => countArticles(hub) > 0)
    .map((hub) => ({
      hub,
      path: getHubPath(hub),
      count: countArticles(hub),
      neighbors: (hub.nearbyPlaces ?? []).filter((place) => place.path).slice(0, 2),
    }))
    .sort((left, right) => right.count - left.count || left.hub.title.localeCompare(right.hub.title, 'zh-Hant'))
const placeHubs = indexableHubs.filter(
  (hub) => hub.categorySlug === PLACES_CATEGORY_SLUG && hub.placeKind !== 'region',
)
const regionHubs = publishableHubs.filter(
  (hub) => hub.categorySlug === PLACES_CATEGORY_SLUG && hub.placeKind === 'region',
)
const signGroups = [
  ...regionHubs.map((region) => ({
    title: region.title,
    path: getHubPath(region),
    stops: stopsOf(placeHubs.filter((hub) => hub.region?.id === region.id)),
  })),
  {
    title: '其他地點',
    path: `/${PLACES_CATEGORY_SLUG}/`,
    stops: stopsOf(
      placeHubs.filter((hub) => !regionHubs.some((region) => region.id === hub.region?.id)),
    ),
  },
  ...homeCategories
    .filter((category) => category.slug !== PLACES_CATEGORY_SLUG)
    .map((category) => ({
      title: category.title,
      path: `/${category.slug}/`,
      stops: stopsOf(indexableHubs.filter((hub) => hub.categorySlug === category.slug)),
    })),
].filter((group) => group.stops.length > 0)

const siteUrl = new URL('/', Astro.site ?? Astro.url).href
const structuredData = createWebSiteStructuredData(siteUrl)
---

<BaseLayout
  title={`${SITE_NAME}｜日本小地方的交通、住宿與季節`}
  noindex={false}
  structuredData={structuredData}
  description={`${SITE_NAME}寫日本小地方怎麼去、住哪裡。班次少的船和巴士列出時刻表與票價，也寫停航、錯過末班車時可以怎麼辦。`}
>
  <section class="home-hero shell" aria-labelledby="home-title">
    <h1 id="home-title">日本小地方怎麼去、住哪裡</h1>
    <p>班次少的船和巴士，文章裡列出時刻表與票價，也寫停航、錯過末班車時可以怎麼辦。</p>

  </section>

  {latestStories.length > 0 && (
    <section class="home-block shell" aria-labelledby="latest-heading">
      <h2 class="line-heading" id="latest-heading">最新文章</h2>
      <div class="home-cards">
        {latestStories.map(({article, hub, path}, index) => article.cover && (
          <article class="home-card">
            <a class="home-card-media" href={path} tabindex="-1" aria-hidden="true">
              <img
                {...getResponsiveImage(article.cover.url, article.cover.width)}
                sizes={IMAGE_SIZES.storyCard}
                width={article.cover.width}
                height={article.cover.height}
                alt=""
                loading={index === 0 ? 'eager' : 'lazy'}
                decoding="async"
              />
            </a>
            <div class="home-card-copy">
              <a class="place-tag" href={getHubPath(hub)}>{hub.title}</a>
              <h3><a href={path}>{article.title}</a></h3>
              <p>{article.excerpt}</p>
            </div>
          </article>
        ))}
      </div>
    </section>
  )}

  {signGroups.map((group) => (
    <section class="home-block shell" aria-label={group.title}>
      <h2 class="line-heading"><a href={group.path}>{group.title}</a></h2>
      <ul class="station-grid">
        {group.stops.map(({hub, path, count, neighbors}) => (
          <li class="station-card">
            <a class="station-card-name" href={path}>
              <strong>{hub.title}</strong>
              {hub.eyebrow && <span>{hub.eyebrow}</span>}
            </a>
            <p class="station-card-bar">
              <span>{neighbors[0] && <a href={neighbors[0].path}>← {neighbors[0].title}</a>}</span>
              <span>{neighbors[1] && <a href={neighbors[1].path}>{neighbors[1].title} →</a>}</span>
            </p>
            <a class="station-card-foot" href={path}>{count} 篇文章 →</a>
          </li>
        ))}
      </ul>
    </section>
  ))}

  {(aspectDirectories.length > 0 || monthPages.length > 0) && (
    <section class="home-block shell" aria-labelledby="home-lists-heading">
      <h2 class="line-heading" id="home-lists-heading">跨地點查找</h2>
      {aspectDirectories.length > 0 && (
        <nav class="article-tags" aria-label="依主題查找">
          <strong>依主題</strong>
          <div>{aspectDirectories.map((directory) => <a href={directory.path}>{directory.title}</a>)}</div>
        </nav>
      )}
      {monthPages.length > 0 && (
        <nav class="article-tags" aria-label="依月份查找">
          <strong>依月份</strong>
          <div>{monthPages.map((page) => <a href={page.path}>{page.title}</a>)}</div>
        </nav>
      )}
    </section>
  )}
</BaseLayout>
