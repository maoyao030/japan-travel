---
import {getHubPath} from '../../data/hubs'
import BaseLayout from '../../layouts/BaseLayout.astro'
import {getPublishedContentRoutes} from '../../lib/contentRoutes'
import {IMAGE_SIZES, getResponsiveImage} from '../../lib/images'
import type {PublishedArticle, SanityAuthor} from '../../lib/sanity'
import {createProfilePageStructuredData} from '../../lib/structuredData'

/**
 * 作者頁由 Sanity 的作者文件產生。只為至少有一篇已發布文章的作者建頁；
 * 網址代稱 editorial-team 代表編輯部，文章會連到關於頁，不另建作者頁。
 */
export const EDITORIAL_TEAM_SLUG = 'editorial-team'

type AuthoredArticle = {article: PublishedArticle; path: string}

interface Props {
  author: SanityAuthor
  authoredArticles: AuthoredArticle[]
}

export async function getStaticPaths() {
  const {authors, landingArticles, routableArticles} = await getPublishedContentRoutes()
  const allArticles: AuthoredArticle[] = [
    ...landingArticles.map(({article, hub}) => ({article, path: getHubPath(hub)})),
    ...routableArticles.map(({article, path}) => ({article, path})),
  ]

  return authors
    .filter((author) => author.slug && author.slug !== EDITORIAL_TEAM_SLUG)
    .map((author) => ({
      author,
      authoredArticles: allArticles
        .filter(({article}) => article.authorSlug === author.slug)
        .sort(
          (left, right) =>
            Date.parse(right.article.publishedAt) - Date.parse(left.article.publishedAt),
        ),
    }))
    .filter(({authoredArticles}) => authoredArticles.length > 0)
    .map(({author, authoredArticles}) => ({
      params: {slug: author.slug},
      props: {author, authoredArticles} satisfies Props,
    }))
}

const {author, authoredArticles} = Astro.props as Props
const indexableArticles = authoredArticles.filter(({article}) => article.noindex === false)
const description = author.bio?.trim() || `${author.name}在本站撰寫的文章。`
const pageTitle = `${author.name}｜作者介紹`
const siteUrl = new URL('/', Astro.site ?? Astro.url).href
const canonicalUrl = new URL(`/authors/${author.slug}/`, siteUrl).href
const latestUpdate = indexableArticles
  .map(({article}) => article.updatedAt ?? article.publishedAt)
  .sort()
  .at(-1)
const links = (author.links ?? []).filter(
  (link): link is {label: string; url: string} =>
    typeof link.label === 'string' && link.label.trim().length > 0 &&
    typeof link.url === 'string' && /^https?:\/\//.test(link.url),
)
const structuredData = createProfilePageStructuredData({
  breadcrumbs: [
    {name: '首頁', url: siteUrl},
    {name: '作者介紹', url: canonicalUrl},
  ],
  canonicalUrl,
  dateModified: latestUpdate,
  description,
  entity: {
    type: 'Person',
    name: author.name,
    description,
    ...(author.photo
      ? {
          image: {
            url: author.photo.url,
            width: author.photo.width,
            height: author.photo.height,
            caption: author.photo.alt ?? author.name,
          },
        }
      : {}),
    ...(links.length > 0 ? {sameAs: links.map((link) => link.url)} : {}),
  },
  name: pageTitle,
  siteUrl,
})
---

<BaseLayout
  title={pageTitle}
  description={description}
  noindex={indexableArticles.length === 0}
  socialImage={author.photo?.url ?? null}
  structuredData={structuredData}
>
  <article class="author-page shell">
    <nav class="author-breadcrumb" aria-label="麵包屑"><a href="/">首頁</a><span aria-hidden="true">／</span><span>作者介紹</span></nav>
    <header class="author-intro">
      {author.photo && (
        <div class="author-logo">
          <img
            {...getResponsiveImage(author.photo.url, author.photo.width)}
            sizes={IMAGE_SIZES.categoryStoryCard}
            width={author.photo.width}
            height={author.photo.height}
            alt={author.photo.alt ?? author.name}
            loading="eager"
            decoding="async"
          />
        </div>
      )}
      <div>
        <p class="eyebrow">作者介紹</p>
        <h1>{author.name}</h1>
        {author.bio && <p class="author-lead">{author.bio}</p>}
        {author.expertise && <p class="author-opening">{author.expertise}</p>}
      </div>
    </header>
    {links.length > 0 && (
      <div class="author-details">
        <section aria-labelledby="links-heading">
          <h2 id="links-heading">相關連結</h2>
          <dl class="author-facts">
            {links.map((link) => (
              <div><dt>{link.label}</dt><dd><a href={link.url} rel="noopener noreferrer">{link.url}</a></dd></div>
            ))}
          </dl>
        </section>
      </div>
    )}
    <section class="author-articles" aria-labelledby="articles-heading">
      <div class="author-articles-heading">
        <div>
          <p class="eyebrow">文章</p>
          <h2 id="articles-heading">{author.name}的文章</h2>
        </div>
        <p>目前共 {authoredArticles.length} 篇</p>
      </div>
      <div class="article-list">
        {authoredArticles.map(({article, path}, index) => (
          <a class="article-row" href={path}>
            <span>{String(index + 1).padStart(2, '0')}</span>
            <div>
              <h3>{article.title}</h3>
              <p>{article.excerpt}</p>
            </div>
            <b aria-hidden="true">→</b>
          </a>
        ))}
      </div>
    </section>
  </article>
</BaseLayout>

<style>
  .author-page { max-width: 1120px; padding-bottom: 5rem; }
  .author-breadcrumb { display: flex; gap: .65rem; padding-block: 1.8rem; font-size: .85rem; color: #67645d; }
  .author-intro { display: grid; grid-template-columns: auto minmax(0, 1fr); align-items: center; gap: 4rem; padding-block: 2rem 3.5rem; border-bottom: 1px solid #d9d5cc; }
  .author-logo { width: 260px; aspect-ratio: 1; overflow: hidden; background: #e9e5dc; border-radius: 0 2.4rem 0 0; }
  .author-logo img { width: 100%; height: 100%; object-fit: cover; object-position: center; }
  h1 { font-size: clamp(2rem, 4vw, 3.4rem); line-height: 1.3; margin: .8rem 0 1.2rem; }
  .author-lead { max-width: 38rem; line-height: 1.9; margin-top: 1.2rem; }
  .author-opening { color: #68635b; font-size: .9rem; margin-top: 1rem; }
  .author-details { display: grid; grid-template-columns: 1fr 1fr; gap: 4rem; margin-top: 3rem; }
  h2 { font-size: 1.45rem; margin: 0 0 1.5rem; }
  dl { margin: 0; }
  dl > div { padding-block: .85rem; border-bottom: 1px solid #dedbd3; }
  dt { font-size: .8rem; color: #67645d; margin-bottom: .35rem; }
  dd { margin: 0; overflow-wrap: anywhere; }
  .author-articles { margin-top: clamp(4rem, 8vw, 6rem); }
  .author-articles-heading { display: flex; align-items: end; justify-content: space-between; gap: 2rem; margin-bottom: 1rem; }
  .author-articles-heading h2 { margin-bottom: 0; }
  .author-articles-heading > p { margin: 0 0 .2rem; color: #67645d; white-space: nowrap; }
  a:focus-visible { outline: 3px solid #8a5a2c; outline-offset: 4px; }
  @media (max-width: 700px) {
    .author-intro { grid-template-columns: minmax(0, 1fr); gap: 1.7rem; padding-top: .5rem; }
    .author-logo { width: 132px; border-radius: 0 1.4rem 0 0; }
    .author-details { grid-template-columns: minmax(0, 1fr); gap: 2rem; }
    .author-articles-heading { align-items: start; flex-direction: column; gap: .5rem; }
  }
</style>
