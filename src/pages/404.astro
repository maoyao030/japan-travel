---
import BaseLayout from '../layouts/BaseLayout.astro'
import {SITE_NAME} from '../config/site'
import {getPublishedCategories} from '../data/hubs'
import {getPublishedContentRoutes} from '../lib/contentRoutes'

const {publishableHubs} = await getPublishedContentRoutes()
const categories = getPublishedCategories(publishableHubs)
---

<BaseLayout
  title={`找不到頁面｜${SITE_NAME}`}
  description="這個網址可能有誤，或頁面還沒開放。請回到首頁，或從網站分類繼續找。"
  noindex={true}
  socialImage={null}
>
  <section class="not-found">
    <div class="shell not-found-grid">
      <div class="not-found-copy">
        <p class="eyebrow">404｜找不到頁面</p>
        <h1><span>找不到</span><br /><span>這個頁面</span></h1>
        <p>這個網址可能有誤，或頁面還沒開放。你可以回到首頁，或從下方分類繼續找。</p>
        <a class="primary-link" href="/">回首頁</a>
      </div>

      <nav class="not-found-categories" aria-labelledby="not-found-categories-title">
        <p class="eyebrow">也可以從分類找</p>
        <h2 id="not-found-categories-title">你想找哪一類資訊？</h2>
        <ul>
          {categories.map((category) => (
            <li>
              <a href={`/${category.slug}/`}>
                <span>{category.title}</span>
                <span aria-hidden="true">→</span>
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </div>
  </section>
</BaseLayout>
