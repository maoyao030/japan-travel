{
  "schemaVersion": 1,
  "siteBaseUrl": "https://offpathnotes.com",
  "selectionPolicy": "queue-order-not-indexable-in-sanity",
  "statusTracking": "sanity-document-state",
  "runLog": {
    "path": "content-automation/auto-publisher-run-log.md",
    "updateEveryRun": true
  },
  "publicationCadence": {
    "timezone": "Asia/Taipei",
    "triggerIntervalHours": 3,
    "maxProductionUnitsPerRun": 1,
    "productionUnitMode": "individual",
    "lockStaleAfterHours": 12,
    "maxArticlesPerDay": 8
  },
  "batches": []
}
