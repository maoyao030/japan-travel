{
  "name": "japan-travel",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && npm run check:site-worker && npm run check:schema && npm run generate:seo && npm run check:links && npm run check:depth",
    "ci": "npm test && npm run build",
    "generate:seo": "node scripts/generate-seo-files.mjs dist",
    "check:schema": "node scripts/check-structured-data.mjs dist",
    "check:links": "node scripts/check-internal-links.mjs dist",
    "check:depth": "node scripts/check-site-depth.mjs dist",
    "check:site-worker": "tsc --project workers/site/tsconfig.json",
    "queue:validate": "node scripts/validate-article-queue.mjs",
    "queue:lock": "node scripts/manage-auto-publisher-lock.mjs",
    "ops:run": "node scripts/ops-run.mjs",
    "ops:sheet-sync": "node scripts/ops-sheet-sync.mjs",
    "ops:article": "node scripts/ops-article.mjs",
    "ops:group": "node scripts/ops-group.mjs",
    "routine:next": "node scripts/routine-next-action.mjs",
    "image:prepare:cover": "node scripts/prepare-selected-cover.mjs",
    "test": "node --test tests/*.test.ts",
    "deploy": "npm run build && wrangler deploy",
    "preview": "astro preview",
    "astro": "astro"
  },
  "dependencies": {
    "astro": "^7.2.6"
  },
  "allowScripts": {
    "esbuild": true,
    "workerd": true
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "sharp": "^0.35.3",
    "typescript": "^5.9.3",
    "wrangler": "^4.125.0"
  }
}
